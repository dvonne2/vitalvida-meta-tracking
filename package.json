{
  "name": "vitalvida-meta-tracking",
  "version": "0.1.0",
  "description": "Reusable Meta Pixel + CAPI PageView foundation",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./browser": {
      "import": "./dist/src/browser/index.js",
      "types": "./dist/src/browser/index.d.ts"
    },
    "./server": {
      "import": "./dist/src/server/index.js",
      "types": "./dist/src/server/index.d.ts"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "tsc && node --test dist/tests/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}